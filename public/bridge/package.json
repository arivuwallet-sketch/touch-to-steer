{
  "name": "touch-to-steer-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Portable Windows bridge for TouchToSteer",
  "main": "rig-bridge.js",
  "bin": "rig-bridge.js",
  "scripts": {
    "build:exe": "npx --yes @yao-pkg/pkg@6.22.0 . --targets node24-win-x64 --output dist/TouchToSteer-Bridge.exe"
  },
  "dependencies": {
    "vigemclient": "1.5.3",
    "ws": "^8.18.3"
  },
  "pkg": {
    "targets": [
      "node24-win-x64"
    ],
    "assets": [
      "node_modules/vigemclient/**/*.node",
      "drivers/ViGEmBus_1.22.0_x64_x86_arm64.exe",
      "native/mouse-injector.exe"
    ]
  }
}
